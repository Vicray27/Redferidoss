# Copy to .env and fill with real values. Never commit .env.
# F1 ships zero mail-provider keys or deps by design.

# Database (must match POSTGRES_* below; app reaches postgres by service name)
DATABASE_URL="postgresql://referidos:referidos_dev_only@postgres:5432/referidos?schema=public"
POSTGRES_USER="referidos"
POSTGRES_PASSWORD="referidos_dev_only"
POSTGRES_DB="referidos"

# Auth / app
# REQUIRED for login. Signs the session cookie (HS256). Minimum 32 chars, and
# the placeholder below is REJECTED at runtime on purpose — a weak or committed
# key would let anyone forge a ROOT session. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
APP_PUBLIC_URL="http://localhost:3000"

# Object storage (MinIO; app reaches minio by service name)
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_BUCKET="referidos"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="change-me-minio-dev-only"

# Scheduling / bootstrap
TZ_DEFAULT="America/Caracas"
ROOT_EMAIL="root@example.com"
CRON_SECRET="change-me-generate-with-openssl-rand-hex-32"
